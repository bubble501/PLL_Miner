[Unit]
Description=POL Miner for Agent #1
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/PLL/miner
ExecStart=/usr/bin/python3 /path/to/PLL/miner/miner.py --config /path/to/PLL/miner/config.json --continuous
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/path/to/PLL/miner

# Resource limits
LimitNOFILE=65535

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pol-miner-1

[Install]
WantedBy=multi-user.target
